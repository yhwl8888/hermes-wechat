.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FEF3C7 0%, #F9FAFB 100%);
}

.header {
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%);
}

.title-text {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.subtitle-text {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.content {
  padding: 24rpx;
}

.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(245, 158, 11, 0.1);
}

.stat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.stat-icon.enabled {
  background: rgba(16, 185, 129, 0.1);
}

.stat-icon.total {
  background: rgba(79, 70, 229, 0.1);
}

.stat-icon image {
  width: 32rpx;
  height: 32rpx;
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.stat-label {
  font-size: 22rpx;
  color: #6B7280;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
}

.category-tabs {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  margin-bottom: 24rpx;
  padding-bottom: 8rpx;
}

.category-tab {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  font-size: 26rpx;
  color: #6B7280;
  white-space: nowrap;
  transition: all 0.3s;
}

.category-tab.active {
  background: linear-gradient(135deg, #F59E0B, #FBBF24);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3);
}

.skills-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.skill-card {
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.skill-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.skill-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.skill-icon.工具 {
  background: linear-gradient(135deg, #3B82F6, #60A5FA);
}

.skill-icon.开发 {
  background: linear-gradient(135deg, #10B981, #34D399);
}

.skill-icon.分析 {
  background: linear-gradient(135deg, #8B5CF6, #A78BFA);
}

.skill-icon.创意 {
  background: linear-gradient(135deg, #EC4899, #F472B6);
}

.skill-icon image {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(0) invert(1);
}

.skill-switch {
  transform: scale(0.8);
}

.skill-body {
  margin-bottom: 12rpx;
}

.skill-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.skill-desc {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.4;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.skill-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #9CA3AF;
}

.skill-category-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  opacity: 0.9;
}

.skill-category-tag.工具 {
  background: #3B82F6;
}

.skill-category-tag.开发 {
  background: #10B981;
}

.skill-category-tag.分析 {
  background: #8B5CF6;
}

.skill-category-tag.创意 {
  background: #EC4899;
}

.empty-state {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #9CA3AF;
}
