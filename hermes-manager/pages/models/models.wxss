.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F0FDF4 0%, #F9FAFB 100%);
}

.header {
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, #10B981 0%, #34D399 100%);
}

.header-title {
  display: flex;
  flex-direction: column;
}

.title-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.subtitle-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.content {
  padding: 24rpx;
}

.stats-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.1);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #10B981;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #6B7280;
}

.stat-divider {
  width: 2rpx;
  background: #E5E7EB;
  margin: 0 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.add-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #10B981;
  font-size: 26rpx;
  font-weight: 500;
}

.add-icon {
  width: 32rpx;
  height: 32rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-tab {
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  font-size: 26rpx;
  color: #6B7280;
  transition: all 0.3s;
}

.filter-tab.active {
  background: linear-gradient(135deg, #10B981, #34D399);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.model-list {
  margin-bottom: 40rpx;
}

.model-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.model-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.model-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #10B981, #34D399);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.avatar-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.model-info {
  flex: 1;
}

.model-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 4rpx;
}

.model-provider {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
}

.model-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.model-status.online {
  background: rgba(16, 185, 129, 0.1);
  color: #10B981;
}

.model-status.offline {
  background: rgba(107, 114, 128, 0.1);
  color: #6B7280;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.model-body {
  padding: 20rpx 0;
  border-top: 2rpx solid #F3F4F6;
  border-bottom: 2rpx solid #F3F4F6;
  margin-bottom: 20rpx;
}

.model-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meta-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-bottom: 4rpx;
}

.meta-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
}

.model-endpoint {
  display: flex;
  flex-direction: column;
}

.endpoint-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-bottom: 4rpx;
}

.endpoint-value {
  font-size: 24rpx;
  color: #6B7280;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.model-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 16rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
}

.test-btn {
  background: rgba(16, 185, 129, 0.1);
  color: #10B981;
}

.config-btn {
  background: linear-gradient(135deg, #10B981, #34D399);
  color: #FFFFFF;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #9CA3AF;
}

.add-model-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.add-model-panel.show {
  opacity: 1;
  visibility: visible;
}

.panel-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.panel-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 85vh;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.add-model-panel.show .panel-content {
  transform: translateY(0);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 2rpx solid #E5E7EB;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #9CA3AF;
}

.panel-body {
  padding: 24rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 12rpx;
}

.form-input {
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #111827;
}

.panel-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  border-top: 2rpx solid #E5E7EB;
}

.btn-cancel {
  flex: 1;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-cancel::after {
  border: none;
}

.btn-confirm {
  flex: 1;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #10B981, #34D399);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-confirm::after {
  border: none;
}
