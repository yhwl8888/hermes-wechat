<view class="page">
  <view class="form-section">
    <text class="section-title">基本信息</text>
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">任务名称</text>
        <input class="form-input" placeholder="输入任务名称" bindinput="onNameInput" value="{{task.name}}" />
      </view>
      <view class="form-item">
        <text class="form-label">任务类型</text>
        <picker mode="selector" range="{{taskTypes}}" range-key="label" bindchange="onTypeChange">
          <view class="picker-value">
            <text>{{selectedType.label}}</text>
            <image class="arrow-icon" src="/assets/icons/arrow-right.png" mode="aspectFit"></image>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <view class="form-section">
    <text class="section-title">执行时间</text>
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">执行周期</text>
        <picker mode="selector" range="{{cycleTypes}}" range-key="label" bindchange="onCycleChange">
          <view class="picker-value">
            <text>{{selectedCycle.label}}</text>
            <image class="arrow-icon" src="/assets/icons/arrow-right.png" mode="aspectFit"></image>
          </view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">执行时间</text>
        <picker mode="time" value="{{executeTime}}" bindchange="onTimeChange">
          <view class="picker-value">
            <text>{{executeTime}}</text>
            <image class="arrow-icon" src="/assets/icons/arrow-right.png" mode="aspectFit"></image>
          </view>
        </picker>
      </view>
      <view class="cron-display">
        <text class="cron-label">Cron表达式</text>
        <text class="cron-value">{{cronExpression}}</text>
      </view>
    </view>
  </view>

  <view class="form-section">
    <text class="section-title">任务配置</text>
    <view class="form-card">
      <view class="form-item" wx:if="{{task.type === 'message'}}">
        <text class="form-label">消息内容</text>
        <textarea class="form-textarea" placeholder="输入要发送的消息内容" bindinput="onMessageInput" value="{{task.params.message}}" />
      </view>
      <view class="form-item" wx:if="{{task.type === 'skill'}}">
        <text class="form-label">选择技能</text>
        <picker mode="selector" range="{{skills}}" range-key="name" bindchange="onSkillSelect">
          <view class="picker-value">
            <text>{{selectedSkillName}}</text>
            <image class="arrow-icon" src="/assets/icons/arrow-right.png" mode="aspectFit"></image>
          </view>
        </picker>
      </view>
      <view class="form-item" wx:if="{{task.type === 'report'}}">
        <text class="form-label">报告类型</text>
        <picker mode="selector" range="{{reportTypes}}" range-key="label" bindchange="onReportTypeChange">
          <view class="picker-value">
            <text>{{selectedReportType.label}}</text>
            <image class="arrow-icon" src="/assets/icons/arrow-right.png" mode="aspectFit"></image>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <view class="form-section">
    <text class="section-title">提醒设置</text>
    <view class="form-card">
      <view class="form-item switch-item">
        <text class="form-label">执行前提醒</text>
        <switch checked="{{task.notifyBefore}}" bindchange="onNotifyChange" />
      </view>
      <view class="form-item" wx:if="{{task.notifyBefore}}">
        <text class="form-label">提醒时间</text>
        <picker mode="selector" range="{{notifyTimes}}" bindchange="onNotifyTimeChange">
          <view class="picker-value">
            <text>提前 {{notifyBeforeMinutes}} 分钟</text>
            <image class="arrow-icon" src="/assets/icons/arrow-right.png" mode="aspectFit"></image>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <view class="form-actions">
    <button class="btn-create" bindtap="onCreateTask">
      <text>创建任务</text>
    </button>
  </view>
</view>
