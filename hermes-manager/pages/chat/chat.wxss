.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F9FAFB;
}

.chat-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #E5E7EB;
}

.header-left, .header-right {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon, .settings-icon {
  width: 40rpx;
  height: 40rpx;
}

.header-center {
  flex: 1;
  text-align: center;
}

.chat-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 4rpx;
}

.chat-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.model-label, .skills-count {
  font-size: 22rpx;
  color: #6B7280;
}

.separator {
  color: #D1D5DB;
}

.messages-container {
  flex: 1;
  overflow-y: auto;
}

.messages-wrapper {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.message-item {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}

.message-item.user {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4F46E5, #818CF8);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-avatar {
  background: linear-gradient(135deg, #10B981, #34D399);
}

.avatar-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.message-content {
  max-width: 70%;
  margin: 0 16rpx;
}

.message-bubble {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border-top-left-radius: 4rpx;
}

.message-item.user .message-bubble {
  background: linear-gradient(135deg, #4F46E5, #818CF8);
  border-top-left-radius: 20rpx;
  border-top-right-radius: 4rpx;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #111827;
}

.message-item.user .message-text {
  color: #FFFFFF;
}

.message-time {
  display: block;
  font-size: 20rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
  text-align: right;
}

.message-item.user .message-time {
  text-align: left;
}

.typing-indicator {
  display: flex;
  align-items: center;
  padding: 20rpx;
  gap: 8rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9CA3AF;
  animation: typing 1.4s infinite ease-in-out both;
}

.typing-dot:nth-child(1) { animation-delay: -0.32s; }
.typing-dot:nth-child(2) { animation-delay: -0.16s; }
.typing-dot:nth-child(3) { animation-delay: 0s; }

@keyframes typing {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

.input-area {
  position: relative;
  background: #FFFFFF;
  border-top: 2rpx solid #E5E7EB;
  padding: 16rpx 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.input-container {
  display: flex;
  align-items: flex-end;
  background: #F3F4F6;
  border-radius: 40rpx;
  padding: 12rpx 12rpx 12rpx 24rpx;
}

.message-input {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
  max-height: 200rpx;
  color: #111827;
  padding: 8rpx 0;
}

.input-placeholder {
  color: #9CA3AF;
}

.input-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.action-btn::after {
  border: none;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.6;
}

.send-btn {
  background: #E5E7EB;
}

.send-btn.active {
  background: linear-gradient(135deg, #4F46E5, #818CF8);
}

.send-btn.active .action-icon {
  opacity: 1;
}

.send-icon {
  filter: brightness(0) invert(1);
}

.skills-panel {
  position: absolute;
  bottom: 100%;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 60vh;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.skills-panel.show {
  transform: translateY(0);
}

.skills-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 2rpx solid #E5E7EB;
}

.skills-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.close-btn {
  padding: 8rpx 16rpx;
}

.close-btn text {
  font-size: 28rpx;
  color: #6B7280;
}

.skills-list {
  padding: 16rpx 24rpx;
  max-height: 50vh;
  overflow-y: auto;
}

.skill-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  transition: background 0.2s;
}

.skill-item:active {
  background: #F3F4F6;
}

.skill-item.enabled {
  background: rgba(79, 70, 229, 0.05);
}

.skill-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #D1D5DB;
  border-radius: 8rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.skill-item.enabled .skill-checkbox {
  background: #4F46E5;
  border-color: #4F46E5;
}

.checkbox-icon {
  width: 24rpx;
  height: 24rpx;
}

.skill-info {
  flex: 1;
}

.skill-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 4rpx;
}

.skill-desc {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
}

.settings-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.settings-panel.show {
  opacity: 1;
  visibility: visible;
}

.settings-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.settings-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.settings-panel.show .settings-content {
  transform: translateY(0);
}

.settings-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 2rpx solid #E5E7EB;
}

.settings-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 8rpx;
}

.settings-body {
  padding: 24rpx;
}

.setting-item {
  margin-bottom: 32rpx;
}

.setting-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 12rpx;
}

.setting-input {
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #111827;
}

.picker-value {
  display: flex;
  align-items: center;
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #111827;
}

.temp-slider {
  width: 100%;
  margin: 12rpx 0;
}

.temp-value {
  font-size: 28rpx;
  color: #6B7280;
  text-align: right;
}

.settings-footer {
  padding: 24rpx;
  border-top: 2rpx solid #E5E7EB;
}

.btn-save {
  background: linear-gradient(135deg, #4F46E5, #818CF8);
  color: #FFFFFF;
  border: none;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-save::after {
  border: none;
}
