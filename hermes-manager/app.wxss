page {
  --primary-color: #4F46E5;
  --primary-light: #818CF8;
  --secondary-color: #10B981;
  --accent-color: #F59E0B;
  --background: #F9FAFB;
  --surface: #FFFFFF;
  --text-primary: #111827;
  --text-secondary: #6B7280;
  --border-color: #E5E7EB;
  --danger-color: #EF4444;
}

page {
  background-color: var(--background);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.container {
  padding: 24rpx;
  min-height: 100vh;
}

.card {
  background: var(--surface);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
  color: #FFFFFF;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: var(--surface);
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.input-field {
  background: var(--surface);
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.input-field:focus {
  border-color: var(--primary-color);
}

.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: var(--primary-light);
  color: #FFFFFF;
  opacity: 0.2;
}

.tag.active {
  opacity: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-state text {
  color: var(--text-secondary);
  font-size: 28rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--surface);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.list-item-left {
  flex: 1;
}

.list-item-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.list-item-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-badge.online {
  background: rgba(16, 185, 129, 0.1);
  color: var(--secondary-color);
}

.status-badge.offline {
  background: rgba(107, 114, 128, 0.1);
  color: var(--text-secondary);
}

.status-badge.active {
  background: rgba(79, 70, 229, 0.1);
  color: var(--primary-color);
}

.status-badge.paused {
  background: rgba(245, 158, 11, 0.1);
  color: var(--accent-color);
}
